<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CRUD_HOTELES.Base.pages.Site" %>
<!DOCTYPE html>
<html>

<head runat="server">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!-- Fonts / Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:wght@300;400;500;700&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!-- Ícono Bootstrap SI lo ocupas -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

  <!-- Bootstrap & Core UI -->
  <link rel="stylesheet" href="<%= ResolveUrl("~/Login/css/bootstrap.min.css") %>" />
  <link rel="stylesheet" href="<%= ResolveUrl("~/Login/css/style.css") %>" />
  <link rel="stylesheet" href="<%= ResolveUrl("~/Login/css/responsive.css") %>" />
  <link rel="stylesheet" href="<%= ResolveUrl("~/Login/css/jquery.mCustomScrollbar.min.css") %>" />


  <!-- Material Dashboard (Sólo afecta a páginas con su layout) -->
  <link href="<%= ResolveUrl("~/Base/assets/css/nucleo-icons.css") %>" rel="stylesheet" />
  <link href="<%= ResolveUrl("~/Base/assets/css/nucleo-svg.css") %>" rel="stylesheet" />
  <link id="pagestyle" href="<%= ResolveUrl("~/Base/assets/css/material-dashboard.css?v=3.2.0") %>" rel="stylesheet" />

  <link href="https://fonts.googleapis.com/css?family=Nunito:300,400,600,700,800,900&display=swap" rel="stylesheet">

  <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body class="g-sidenav-show bg-gray-100">

  <!-- SIDENAV -->
  <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-radius-lg fixed-start ms-2 bg-white my-2" id="sidenav-main">
    <hr class="horizontal dark mt-0 mb-2">
    <div class="collapse navbar-collapse w-auto" id="sidenav-collapse-main">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link text-dark" href="<%= ResolveUrl("~/Base/pages/dashboard.aspx") %>">
            <i class="material-symbols-rounded opacity-5">dashboard</i>
            <span class="nav-link-text ms-1">Panel de Control</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-dark" href="<%= ResolveUrl("~/Base/pages/frmConsultaHoteles.aspx") %>">
            <i class="material-symbols-rounded opacity-5">receipt_long</i>
            <span class="nav-link-text ms-1">Consultar Hoteles</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-dark" href="<%= ResolveUrl("~/Base/pages/frmMantenimientoHoteles.aspx") %>">
            <i class="material-symbols-rounded opacity-5">hotel</i>
            <span class="nav-link-text ms-1">Mantenimiento Hoteles</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-dark" href="<%= ResolveUrl("~/Base/pages/frmConsultaHabitaciones.aspx") %>">
            <i class="material-symbols-rounded opacity-5">nest_multi_room</i>
            <span class="nav-link-text ms-1">Consultar Habitaciones</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-dark" href="<%= ResolveUrl("~/Base/pages/frmMantenimientoHabitaciones.aspx") %>">
            <i class="material-symbols-rounded opacity-5">holiday_village</i>
            <span class="nav-link-text ms-1">Mantenimiento Habitaciones</span>
          </a>
        </li>

        <li class="nav-item mt-3">
          <h6 class="ps-4 ms-2 text-uppercase text-xs text-dark font-weight-bolder opacity-5">Cuenta</h6>
        </li>

        <li class="nav-item">
          <a class="nav-link text-dark" href="<%= ResolveUrl("~/Login/frmInicioSesion.aspx") %>">
            <i class="material-symbols-rounded opacity-5">login</i>
            <span class="nav-link-text ms-1">Iniciar Sesión</span>
          </a>
        </li>

      </ul>
    </div>
  </aside>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <!-- NAVBAR SUPERIOR -->
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-3 shadow-none border-radius-xl" id="navbarBlur" data-scroll="true">
      <div class="container-fluid py-1 px-3">
        <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">

          <div class="ms-md-auto pe-md-3 d-flex align-items-center">
            <div class="input-group input-group-outline">
              <label class="form-label">Buscar...</label>
              <input type="text" class="form-control" />
            </div>
          </div>

          <ul class="navbar-nav d-flex align-items-center justify-content-end">
            <li class="nav-item dropdown pe-3 d-flex align-items-center">
              <a href="javascript:;" class="nav-link text-body p-0" id="dropdownMenuButton"
                 data-bs-toggle="dropdown" aria-expanded="false">
                <i class="material-symbols-rounded">account_circle</i>
              </a>

              <ul class="dropdown-menu dropdown-menu-end px-2 py-3 me-sm-n4" aria-labelledby="dropdownMenuButton">
                <li class="mb-2">
                  <div class="user-info text-center">
                    <h6 id="lblNombreUsuario" class="user-name text-dark mb-0"></h6>
                    <p id="lblEmlUsuario" class="text-secondary mb-1"></p>
                  </div>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li class="text-center">
                  <a href="#" class="dropdown-item text-danger" onclick="cerrarSesion()">
                    <i class="fa fa-power-off me-2"></i> Cerrar Sesión
                  </a>
                </li>
              </ul>
            </li>
          </ul>

        </div>
      </div>
    </nav>

    <!-- CONTENIDO -->
    <div class="container-fluid py-2">
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>
  </main>

  <!-- JS Core -->
  <script src="<%= ResolveUrl("~/Base/assets/js/core/popper.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Base/assets/js/core/bootstrap.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Base/assets/js/plugins/perfect-scrollbar.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Base/assets/js/plugins/smooth-scrollbar.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Base/assets/js/material-dashboard.min.js?v=3.2.0") %>"></script>
  <script src="<%= ResolveUrl("~/Login/js/jquery.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Login/js/bootstrap.bundle.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Login/js/jquery.mCustomScrollbar.concat.min.js") %>"></script>
  <script src="<%= ResolveUrl("~/Login/js/custom.js") %>"></script>


  <!-- Librerías JS comunes -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Gestión de sesión y cookies -->
  <script src="../../JavaScript/jquery.cookie.js"></script>
  <script src="../../JavaScript/InicioSesion.js"></script>

  <!-- DataTables -->
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
  <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

  <!-- Scripts adicionales de páginas -->
  <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />

  <!-- Script sesión: comportamiento similar a Fabricantes -->
  <script>
    $(document).ready(function () {
        // Mostrar datos de usuario desde las cookies (como en Fabricantes)
        const nombre = $.cookie("GLBDSC");
        const correo = $.cookie("GLBCOD");

        if (nombre && correo) {
            $("#lblNombreUsuario").text(nombre);
            $("#lblEmlUsuario").text(correo);
        } else {
            $("#lblNombreUsuario").text("Invitado");
            $("#lblEmlUsuario").text("");
        }
    });

    function cerrarSesion() {
        $.removeCookie("GLBDSC");
        $.removeCookie("GLBCOD");
        Swal.fire({
            icon: "success",
            title: "Sesión cerrada",
            text: "Tu sesión ha sido finalizada correctamente.",
            timer: 1500,
            showConfirmButton: false
        }).then(() => {
            window.location.href = "../../Login/frmInicioSesion.aspx";
        });
    }
  </script>

</body>
</html>
